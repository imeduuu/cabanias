# Local Docker: npm run db:local:setup generates .env and ignored secrets.
# Manual alternative: set your own PostgreSQL connection string.
DATABASE_URL=""
# Generated locally for the disposable postgres-test service; never use production.
TEST_DATABASE_URL=""
# npm run auth:setup generates a local secret; use HTTPS and a unique secret in production.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
# URL canónica pública del sitio; se usa en metadata, Open Graph, sitemap y JSON-LD.
SITE_URL="http://localhost:3000"
# Directorio persistente para imágenes cargadas; en OCI monta un volumen en esta ruta.
IMAGE_STORAGE_DIR=""
# SMTP for transactional notifications; local development can use Mailpit.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Cabañas <no-reply@example.test>"
SMTP_SECURE="false"
